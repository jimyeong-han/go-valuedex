{
  "name": "go-valuedex",
  "version": "1.3.0",
  "private": true,
  "description": "Browser regression tests for the GO ValueDex GitHub Pages app",
  "scripts": {
    "serve:e2e": "node tests/e2e/server.mjs",
    "test": "npm run test:mechanics && npm run test:browser",
    "test:mechanics": "node scripts/mechanics-tests.mjs",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
